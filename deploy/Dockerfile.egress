# runebox egress proxy: init container (--setup-iptables) and sidecar.
# It also carries runebox-supervisor, which the Kubernetes backend copies
# into supervised sandbox Pods (an init container shares it through an
# emptyDir), so the sandbox image need not carry or be trusted with it.

# runebox-egress and runebox-supervisor from the Rust workspace. Built
# natively for the target platform (no --platform=$BUILDPLATFORM: the
# Alpine/musl toolchain links static binaries for the runtime stage below
# without a cross linker). TLS is rustls with ring; no OpenSSL or aws-lc.
FROM rust:1.99-alpine@sha256:b1d5dd5a22a09404d3e798c0cf051b689077360374eb505fa5bb93c479693d87 AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p runebox-egress -p runebox-supervisor \
        --bin runebox-egress --bin runebox-supervisor \
    && install -D -m 0755 target/release/runebox-egress /out/runebox-egress \
    && install -D -m 0755 target/release/runebox-supervisor /out/runebox-supervisor

# A small Alpine runtime provides iptables (for the --setup-iptables init
# container, which runs with NET_ADMIN) without Debian's otherwise-unused
# Perl runtime, reducing both the attack surface and unfixed package CVEs.
# iptables-legacy is the fallback where nftables is missing (gVisor).
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache \
    && apk add --no-cache iptables iptables-legacy ca-certificates
RUN adduser -S -D -H -u 10001 -G root egress
COPY --from=build /out/runebox-egress /usr/local/bin/runebox-egress
# Static, so it runs in any sandbox image (see the header).
COPY --from=build /out/runebox-supervisor /usr/local/bin/runebox-supervisor
USER 10001
ENTRYPOINT ["/usr/local/bin/runebox-egress"]
CMD ["--addr", ":8888", "--policy", "/etc/runebox/policy.json"]
