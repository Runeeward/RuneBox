# Default sandbox image: headless Chromium + the runebox-browser CDP driver,
# so the governed browser tool works out of the box, and runebox-supervisor,
# the in-sandbox entrypoint that confines the agent (Landlock, seccomp, a
# dropped identity) for Charters with [filesystem] or [process]. Any image
# works as a sandbox; profiles that don't use the browser tool or the
# supervisor can use any base.

# runebox-supervisor and runebox-browser from the Rust workspace. Built
# natively for the target platform (no --platform=$BUILDPLATFORM: the
# Alpine/musl toolchain links static binaries for the runtime stage below
# without a cross linker).
FROM rust:1.99-alpine@sha256:b1d5dd5a22a09404d3e798c0cf051b689077360374eb505fa5bb93c479693d87 AS rust-build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p runebox-supervisor -p runebox-browser \
        --bin runebox-supervisor --bin runebox-browser \
    && install -D -m 0755 target/release/runebox-supervisor /out/runebox-supervisor \
    && install -D -m 0755 target/release/runebox-browser /out/runebox-browser

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache \
    && apk add --no-cache chromium ca-certificates curl python3 'nodejs>=24.22.1-r0' 'brotli-libs>=1.2.1-r0'
COPY --from=rust-build /out/runebox-browser /usr/local/bin/runebox-browser
# The control plane starts supervised sandboxes with this as PID 1.
COPY --from=rust-build /out/runebox-supervisor /usr/local/bin/runebox-supervisor

RUN adduser -D -u 1000 sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace
USER sandbox
ENV HOME=/home/sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]
